{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed1116/HALO-RoboMME/schemas/vqa/v1/request.schema.json",
  "title": "HALO RoboMME VQA pilot request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_name",
    "suite_name",
    "episode_id",
    "task_goal",
    "query_timestep",
    "timeline",
    "known_counts_by_family"
  ],
  "properties": {
    "schema_version": {"const": "halo.robomme.vqa.request/v1"},
    "task_name": {"type": "string"},
    "suite_name": {"enum": ["counting", "permanence", "reference", "imitation"]},
    "episode_id": {"type": "string", "pattern": "^[A-Za-z0-9]+/episode_[0-9]+$"},
    "task_goal": {"type": "string", "minLength": 1},
    "query_timestep": {"type": "integer", "minimum": 0},
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestep",
          "front_image",
          "wrist_image",
          "event_boundary",
          "change_score"
        ],
        "properties": {
          "timestep": {"type": "integer", "minimum": 0},
          "front_image": {"type": "string", "minLength": 1},
          "wrist_image": {"type": "string", "minLength": 1},
          "event_boundary": {"type": "boolean"},
          "change_score": {"type": "number", "minimum": 0}
        }
      }
    },
    "known_counts_by_family": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
